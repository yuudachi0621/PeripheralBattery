<Window x:Class="PeripheralBattery.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="408" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <!-- 主按钮：陶土橙实底 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Width" Value="84"/>
            <Setter Property="Padding" Value="0,6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次按钮：描边 -->
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" BorderThickness="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource DividerBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 复选框：去掉系统方框，改成圆角方块 + 对勾，选中时用陶土橙 -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                    VerticalAlignment="Center" Margin="0,0,9,0"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1.4">
                                <Path x:Name="Tick" Data="M3.5,8.5 L6.5,11.5 L12,4.5"
                                      Stroke="#FFFFFF" StrokeThickness="1.9"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Visibility="Collapsed"
                                      Width="12" Height="12" Stretch="Uniform"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉框：圆角卡片感，替换掉系统默认的灰盒子 -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" CornerRadius="8" BorderThickness="1"
                                                Background="{DynamicResource CardBrush}"
                                                BorderBrush="{DynamicResource DividerBrush}"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="Content" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>

                            <Path Data="M0,0 L4,4 L8,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,11,0" IsHitTestVisible="False"
                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                                <Border Margin="0,4,0,0" CornerRadius="8" Padding="4"
                                        Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="220">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <!-- 显式限宽：根元素是 StackPanel，纵向排列时它不给子元素宽度约束，
                 TextWrapping 就只能在"理想宽度"里折行，长句会溢出到窗口外被裁。 -->
            <Setter Property="MaxWidth" Value="348"/>
        </Style>
    </Window.Resources>

    <!-- 根元素是 StackPanel：它在排列方向（纵向）上不给子元素宽度约束，
         TextWrapping="Wrap" 只会在"理想宽度"里折行，长说明文字会一路溢出到窗口外被裁掉。
         所以说明文字靠上面 Caption 样式里的 MaxWidth=348 显式限宽来兜底。
         （将来若把根元素换成 Grid，宽度约束会自然传下去，那时可以去掉那个 MaxWidth。） -->
    <StackPanel x:Name="ContentStack" Margin="22,20,22,18">
        <TextBlock Text="刷新间隔" FontWeight="SemiBold"/>
        <ComboBox x:Name="IntervalBox" Margin="0,8,0,0" Padding="9,5"/>
        <TextBlock Style="{StaticResource Caption}"
                   Text="读一次电量的时间间隔。鼠标/键盘走 HID，几乎不耗电；蓝牙需要唤醒射频，间隔太短会更费电。"/>

        <TextBlock Text="低电量提醒" FontWeight="SemiBold" Margin="0,20,0,0"/>
        <CheckBox x:Name="NotifyBox" Content="电量低时弹出 Windows 通知，托盘图标转红"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="低于" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <ComboBox x:Name="ThresholdBox" Width="88" Margin="8,0,8,0" Padding="9,4"/>
            <TextBlock Text="时提醒" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <TextBlock Text="托盘图标" FontWeight="SemiBold" Margin="0,20,0,0"/>
        <ComboBox x:Name="PrimaryBox" Margin="0,8,0,0" Padding="9,5"/>
        <TextBlock Style="{StaticResource Caption}"
                   Text="选一台设备后，托盘图标只显示它的电量；悬停提示和面板仍会列出所有在线设备。选「自动」则显示所有在线设备里电量最低的那台。"/>

        <TextBlock Text="设备列表" FontWeight="SemiBold" Margin="0,20,0,0"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <!-- 显式设 Auto 宽度：GhostButton 继承自 PrimaryButton，那里固定了 Width=84，
                 "扫描其他设备…" 比 84 宽，不自适应就会被裁成"扫描其他设" -->
            <Button Content="扫描其他设备…" Style="{StaticResource GhostButton}"
                    Width="Auto" Padding="14,5" Click="Scan_Click"/>
        </StackPanel>
        <TextBlock Style="{StaticResource Caption}"
                   Text="把附近的外设扫描出来，勾选后加入面板。面板里右键设备可以移除，移除后还能在这里重新扫描找回。"/>

        <TextBlock Text="其他" FontWeight="SemiBold" Margin="0,20,0,0"/>
        <CheckBox x:Name="AutoStartBox" Content="开机自动启动（登录后直接缩到托盘）"/>
        <CheckBox x:Name="ShowOfflineBox" Content="显示离线/历史设备（折叠区）"/>
        <CheckBox x:Name="ThrottleBox" Content="空闲时自动降低轮询频率"/>

        <TextBlock x:Name="HintText" Style="{StaticResource Caption}" Margin="0,20,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                    IsCancel="True" Click="Cancel_Click"/>
            <Button Content="保存" Style="{StaticResource PrimaryButton}"
                    IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
