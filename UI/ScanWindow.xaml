<Window x:Class="PeripheralBattery.UI.ScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PeripheralBattery.UI"
        xmlns:models="clr-namespace:PeripheralBattery.Models"
        Title="扫描其他设备" Width="452" Height="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <ui:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <ui:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" BorderThickness="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource DividerBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1.4">
                            <Path x:Name="Tick" Data="M3.5,8.5 L6.5,11.5 L12,4.5"
                                  Stroke="#FFFFFF" StrokeThickness="1.9"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Visibility="Collapsed"
                                  Width="11" Height="11" Stretch="Uniform"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="扫描其他设备" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock x:Name="HintText" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="四条通道（2.4G 接收器 / 蓝牙 LE / 经典蓝牙 / OPPO 私有协议）会各跑一遍，大约 3~10 秒。"/>
        </StackPanel>

        <!-- 扫描中 / 未开始时的占位 -->
        <Border Grid.Row="1" x:Name="BusyBar" CornerRadius="8" Padding="12,9" Margin="0,12,0,0"
                Background="{DynamicResource AccentSoftBrush}" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="正在扫描…" FontSize="11.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}"/>
            </StackPanel>
        </Border>

        <!-- 结果列表 -->
        <Border Grid.Row="2" Margin="0,12,0,0" CornerRadius="10"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                    <ItemsControl x:Name="ResultList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" CornerRadius="7" Padding="9,7" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                                  IsChecked="{Binding Selected, Mode=TwoWay}"
                                                  IsEnabled="{Binding AlreadyAdded, Converter={StaticResource InverseBoolToVis}}"/>

                                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding SubText}" FontSize="10.5" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <!-- 电量区与主面板同口径：充电时挂闪电、读不到电量时画"未知"图标，
                                                 文字只在有内容时出现（空字符串不占宽度） -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Path Data="{x:Static models:DeviceIcons.Charge}"
                                                      Fill="{Binding ChargeBrush}"
                                                      Width="8" Height="8" Stretch="Uniform"
                                                      Margin="0,1,2,0" VerticalAlignment="Center"
                                                      ToolTip="{Binding LevelHint}"
                                                      Visibility="{Binding ShowChargeIcon, Converter={StaticResource BoolToVis}}"/>
                                                <Path Data="{x:Static models:DeviceIcons.Unknown}"
                                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                                      StrokeThickness="1.2" Fill="Transparent"
                                                      Width="12" Height="12" Stretch="Uniform"
                                                      Margin="0,1,2,0" VerticalAlignment="Center"
                                                      ToolTip="{Binding LevelHint}"
                                                      Visibility="{Binding ShowLevelUnknown, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{Binding LevelText}" FontSize="12" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <!-- 已添加的用暖绿标"已添加"，未添加的用陶土橙标"未添加"，
                                                 这样一眼能看出哪些是已经收进面板的 -->
                                            <TextBlock x:Name="Status" Text="{Binding StatusText}" FontSize="9.5"
                                                       Margin="0,2,0,0" HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding AlreadyAdded}" Value="True">
                                        <Setter TargetName="Status" Property="Foreground"
                                                Value="{DynamicResource SuccessBrush}"/>
                                        <Setter TargetName="Row" Property="Opacity" Value="0.72"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AlreadyAdded}" Value="False">
                                        <Setter TargetName="Status" Property="Foreground"
                                                Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 空状态：没扫到 / 还没扫 -->
                <TextBlock x:Name="EmptyText" Margin="18" TextWrapping="Wrap" VerticalAlignment="Top"
                           FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="点下面的「开始扫描」查找附近的外设。"/>
            </Grid>
        </Border>

        <!-- 底部按钮 -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Button x:Name="ScanButton" Content="开始扫描" HorizontalAlignment="Left"
                    Style="{StaticResource GhostButton}" Click="Scan_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                        IsCancel="True" Click="Cancel_Click"/>
                <Button x:Name="AddButton" Content="添加所选" Style="{StaticResource PrimaryButton}"
                        IsEnabled="False" Click="Add_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
